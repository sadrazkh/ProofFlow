# Copy to .env and fill both in. `docker compose up` refuses to start without them, which is
# deliberate: the two values below are the ones that must not have a default.
#
#   cp .env.example .env

# The database password. Any long random string; nothing else reads it.
#
#   openssl rand -base64 24
POSTGRES_PASSWORD=

# What every secret in this installation is encrypted with — the credentials your tests send to
# your own APIs, and the signing key of every runner you enrol.
#
#   openssl rand -base64 32
#
# Keep it exactly as safe as those credentials, and back it up with the database: restoring rows
# encrypted with a key you no longer have restores nothing. Changing it does not re-encrypt
# anything; it makes what is already stored unreadable.
PROOFFLOW_MASTER_KEY=

# Where to publish the application. Change it if 8080 is taken.
PROOFFLOW_PORT=8080

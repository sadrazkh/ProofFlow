{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "Database": {
    "Provider": "sqlite",
    // The worker never migrates. Two processes racing to apply the same DDL is a corrupt schema,
    // and the web application is the one that owns it.
    "AutoMigrate": false
  },
  "ConnectionStrings": {
    "Default": ""
  }
}

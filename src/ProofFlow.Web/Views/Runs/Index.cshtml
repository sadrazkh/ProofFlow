@using ProofFlow.Domain.Runs
@model RunListViewModel

<div class="page-head">
    <div>
        <h1 class="page-title">@T["nav.runs"]</h1>
        <p class="page-subtitle">@T["run.empty.body"]</p>
    </div>
</div>

@if (Model.Runs.Count > 0 || Model.Narrowed)
{
    @*
        A plain GET form: no JavaScript, and a narrowed history is a URL that can be sent to
        whoever asked «did checkout pass last night».
    *@
    <form method="get" action="/projects/@Model.ProjectId/runs" class="card">
        <div class="card-body row wrap" style="gap: var(--space-3); align-items: flex-end;">
            <div class="field grow" style="min-inline-size: 220px;">
                <label class="field-label" for="run-filter">@T["run.filter.label"]</label>
                <input class="input" id="run-filter" name="q" value="@Model.Query"
                       placeholder="@T["run.filter.hint"]" dir="auto" autocomplete="off" />
            </div>
            <div class="field" style="min-inline-size: 170px;">
                <label class="field-label" for="run-verdict">@T["run.column.verdict"]</label>
                <select class="select" id="run-verdict" name="status">
                    <option value="" selected="@(Model.Status is null)">@T["run.filter.any"]</option>
                    @foreach (var verdict in new[]
                    {
                        RunStatus.Passed, RunStatus.Failed, RunStatus.Errored, RunStatus.Running,
                    })
                    {
                        <option value="@verdict" selected="@(Model.Status == verdict)">
                            @T[$"run.status.{verdict.ToString().ToLowerInvariant()}"]
                        </option>
                    }
                </select>
            </div>
            <button type="submit" class="btn btn-secondary">
                <i data-lucide="filter" aria-hidden="true"></i>@T["run.filter.action"]
            </button>
            @if (Model.Narrowed)
            {
                <a class="btn btn-ghost" href="/projects/@Model.ProjectId/runs">@T["run.filter.clear"]</a>
            }
        </div>
    </form>
}

@if (Model.Runs.Count == 0 && Model.Narrowed)
{
    @* Not «no runs yet»: there are runs, and none of them is this one. *@
    <div class="card">
        <div class="empty">
            <div class="empty-art"><i data-lucide="search" aria-hidden="true"></i></div>
            <h2 class="empty-title">
                @if (Model.Query is { } missed)
                {
                    @T["run.filter.none.title", missed]
                }
                else
                {
                    @T["run.filter.none.verdict"]
                }
            </h2>
            <p class="empty-body">@T["run.filter.none.body"]</p>
            <div class="empty-actions">
                <a class="btn btn-secondary" href="/projects/@Model.ProjectId/runs">
                    @T["run.filter.none.action"]
                </a>
            </div>
        </div>
    </div>
}
else if (Model.Runs.Count == 0)
{
    <div class="card">
        <div class="empty">
            <div class="empty-art"><i data-lucide="history" aria-hidden="true"></i></div>
            <h2 class="empty-title">@T["run.empty.title"]</h2>
            <p class="empty-body">@T["run.empty.body"]</p>
            <div class="empty-actions">
                <a class="btn btn-primary" href="/projects/@Model.ProjectId/scenarios">
                    <i data-lucide="workflow" aria-hidden="true"></i>@T["nav.scenarios"]
                </a>
            </div>
        </div>
    </div>
}
else
{
    <div class="card">
        <div class="table-wrap">
            <table class="table table-hover">
                <caption class="sr-only">@T["nav.runs"]</caption>
                <thead>
                <tr>
                    <th>@T["run.column.scenario"]</th>
                    <th>@T["run.column.verdict"]</th>
                    <th class="run-column-wide">@T["run.column.environment"]</th>
                    <th>@T["run.column.checks"]</th>
                    <th>@T["run.column.took"]</th>
                    <th class="run-column-wide">@T["run.column.trigger"]</th>
                    <th>@T["run.column.started"]</th>
                    @if (Model.CanRun)
                    {
                        <th><span class="sr-only">@T["common.actions"]</span></th>
                    }
                </tr>
                </thead>
                <tbody>
                @foreach (var run in Model.Runs)
                {
                    var tone = Verdicts.Tone(run.Status);
                    var badge = $"badge-{tone}";
                    var status = $"status-{tone}";

                    <tr>
                        <td>
                            <a href="/projects/@Model.ProjectId/runs/@run.Id" dir="auto">
                                @(run.ScenarioName ?? T["run.title"].Value)
                            </a>
                        </td>
                        <td>
                            @* A dot, a colour and a word. A verdict told only in green and red is a
                               verdict one reader in twelve cannot read. *@
                            <span class="badge run-row-verdict @badge @status">
                                <span class="status-dot" aria-hidden="true"></span>
                                @T[$"run.status.{run.Status.ToString().ToLowerInvariant()}"]
                            </span>
                        </td>
                        <td class="run-column-wide" dir="auto">@(run.EnvironmentName ?? "—")</td>
                        <td class="tabular" dir="ltr">
                            @if (run.AssertionsPassed + run.AssertionsFailed == 0)
                            {
                                @* An em dash, not a zero. "No checks ran" and "no checks passed"
                                   are different facts and a zero says the wrong one. *@
                                <span class="subtle">—</span>
                            }
                            else
                            {
                                <span>@run.AssertionsPassed</span>
                                <span class="subtle">/</span>
                                <span>@(run.AssertionsPassed + run.AssertionsFailed)</span>
                            }
                        </td>
                        <td class="tabular" dir="ltr">
                            @(run.DurationMs >= 1000
                                ? $"{run.DurationMs / 1000:0.0}s"
                                : $"{Math.Round(run.DurationMs)}ms")
                        </td>
                        <td class="run-column-wide">@T[$"run.trigger.{run.Trigger.ToString().ToLowerInvariant()}"]</td>
                        <td><partial name="Pieces/_Timestamp" model="@(new TimestampView(run.StartedAt))" /></td>
                        @if (Model.CanRun)
                        {
                            <td>
                                @* Only once it is over: pressing «again» on a run still going is a
                                   second copy racing the first against the same API. *@
                                @if (run.Status is not (RunStatus.Queued or RunStatus.Running))
                                {
                                    <form method="post" action="/projects/@Model.ProjectId/runs/@run.Id/again"
                                          style="display: inline;">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-ghost btn-sm has-tip"
                                                aria-label="@T["run.again"]" data-tip="@T["run.again"]">
                                            <i data-lucide="rotate-ccw" aria-hidden="true"></i>
                                        </button>
                                    </form>
                                }
                            </td>
                        }
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}

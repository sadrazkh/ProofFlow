@model AuditListViewModel

<div class="page-head">
    <div>
        <h1 class="page-title">@T["audit.title"]</h1>
        <p class="page-subtitle">@T["audit.subtitle"]</p>
    </div>
</div>

@if (Model.Events.Count == 0)
{
    <div class="card">
        <div class="empty">
            <div class="empty-art"><i data-lucide="shield" aria-hidden="true"></i></div>
            <h2 class="empty-title">@T["audit.empty.title"]</h2>
            <p class="empty-body">@T["audit.empty.body"]</p>
        </div>
    </div>
}
else
{
    <div class="card">
        <div class="table-wrap">
            <table class="table table-hover">
                <thead>
                <tr>
                    <th>@T["audit.actor"]</th>
                    <th>@T["audit.what"]</th>
                    <th>@T["audit.target"]</th>
                    <th>@T["audit.when"]</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var row in Model.Events)
                {
                    @* The action is looked up by key, so the log reads in the reader's language
                       rather than in the language of whoever wrote the call site. An unknown key
                       renders as itself — visibly wrong, which is how it gets reported. *@
                    var label = T[$"audit.action.{row.ActionKey}"];
                    <tr>
                        <td>
                            <span class="row" style="gap: var(--space-2);">
                                <span class="avatar" aria-hidden="true">@(row.Actor.Length > 0 ? row.Actor[..1].ToUpperInvariant() : "?")</span>
                                <span class="truncate" dir="auto">@row.Actor</span>
                            </span>
                        </td>
                        <td>@(label.IsResourceNotFound ? row.ActionKey : (object)label)</td>
                        <td class="muted truncate" dir="auto">@row.TargetLabel</td>
                        <td class="subtle">
                            <partial name="Pieces/_Timestamp" model="@(new TimestampView(row.OccurredAt))" />
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>

    @if (Model.HasMore || Model.Page > 1)
    {
        <div class="row" style="justify-content: center; gap: var(--space-2); margin-block-start: var(--space-5);">
            @if (Model.Page > 1)
            {
                <a class="btn btn-secondary btn-sm" href="/activity?page=@(Model.Page - 1)">@T["action.back"]</a>
            }
            @if (Model.HasMore)
            {
                <a class="btn btn-secondary btn-sm" href="/activity?page=@(Model.Page + 1)">@T["action.next"]</a>
            }
        </div>
    }
}

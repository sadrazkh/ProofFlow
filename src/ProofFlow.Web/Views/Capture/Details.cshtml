@using System.Text.Json
@model CaptureDetailViewModel
@{
    var props = JsonSerializer.Serialize(new
    {
        projectId = Model.ProjectId,
        sessionId = Model.Session.Id,
        canReview = Model.CanReview,
    }, new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase });
}

<div class="page-head">
    <div>
        <h1 class="page-title" dir="auto">@Model.BaselineName</h1>
        <p class="page-subtitle">@T["capture.against", Model.DataSetName, Model.DataSetVersion]</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary" href="/projects/@Model.ProjectId/captures">
            <i data-lucide="arrow-left" class="icon-forward" aria-hidden="true"></i>@T["nav.captures"]
        </a>
    </div>
</div>

<div class="card card-pad stack-2">
    <div class="row wrap">
        <span class="badge @CaptureStatusTone.For(Model.Session.Status)">
            @T[$"capture.session.{Model.Session.Status}"]
        </span>
        <span class="badge badge-idle">@T[$"capture.mode.{Model.Session.Mode}"]</span>
        <span class="text-xs subtle">
            @T["capture.completed", Model.Session.Completed, Model.Session.TotalRows]
        </span>
        <span class="grow"></span>
        <partial name="Pieces/_Timestamp" model="@(new TimestampView(Model.Session.StartedAt))" />
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Session.StoppedReason))
    {
        @* Said rather than left to be inferred from a count that stops short of the total. *@
        <p class="response-notice">
            <i data-lucide="info" aria-hidden="true"></i>@Model.Session.StoppedReason
        </p>
    }
</div>

<div data-island="review-queue" data-props="@props">
    <div class="card card-pad stack">
        <div class="skeleton" style="block-size: 34px;"></div>
        <div class="skeleton" style="block-size: 400px;"></div>
    </div>
</div>

@model CaptureListViewModel

<div class="page-head">
    <div>
        <h1 class="page-title">@T["nav.captures"]</h1>
        <p class="page-subtitle">@T["capture.subtitle"]</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-primary" href="/projects/@Model.ProjectId/wizard">
            <i data-lucide="wand-sparkles" aria-hidden="true"></i>@T["wizard.title"]
        </a>
    </div>
</div>

@if (Model.Sessions.Count == 0)
{
    @* A sweep needs both a baseline to compare against and a set of inputs to sweep it over. The
       empty state points at whichever one is missing rather than at a button that would fail. *@
    <div class="card">
        <div class="empty">
            <div class="empty-art"><i data-lucide="inbox" aria-hidden="true"></i></div>
            <h2 class="empty-title">@T["capture.empty.title"]</h2>
            <p class="empty-body">@T["capture.empty.body"]</p>
            <div class="empty-actions">
                @if (!Model.HasBaselines)
                {
                    <a class="btn btn-primary" href="/projects/@Model.ProjectId/request">
                        <i data-lucide="send" aria-hidden="true"></i>@T["baseline.empty.action"]
                    </a>
                }
                else if (!Model.HasDataSets)
                {
                    <a class="btn btn-primary" href="/projects/@Model.ProjectId/datasets/new">
                        <i data-lucide="table-2" aria-hidden="true"></i>@T["dataset.new"]
                    </a>
                }
                else
                {
                    <a class="btn btn-primary" href="/projects/@Model.ProjectId/wizard">
                        <i data-lucide="wand-sparkles" aria-hidden="true"></i>@T["wizard.title"]
                    </a>
                }
            </div>
        </div>
    </div>
}
else
{
    <div class="card">
        <div class="table-wrap">
            <table class="table">
                <caption class="sr-only">@T["nav.captures"]</caption>
                <thead>
                <tr>
                    <th>@T["nav.baselines"]</th>
                    <th>@T["nav.datasets"]</th>
                    <th>@T["capture.mode"]</th>
                    <th>@T["common.status"]</th>
                    <th>@T["capture.findings"]</th>
                    <th>@T["common.created"]</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var session in Model.Sessions)
                {
                    <tr>
                        <td>
                            <a href="/projects/@Model.ProjectId/captures/@session.Id" dir="auto">@session.BaselineName</a>
                        </td>
                        <td>
                            <span dir="auto">@session.DataSetName</span>
                            <span class="subtle">@T["baseline.version", session.DataSetVersion]</span>
                        </td>
                        <td>@T[$"capture.mode.{session.Mode}"]</td>
                        <td>
                            <span class="badge @CaptureStatusTone.For(session.Status)">
                                @T[$"capture.session.{session.Status}"]
                            </span>
                        </td>
                        <td>
                            <div class="row" style="gap: var(--space-2);">
                                <span class="tabular subtle">@session.TotalRows</span>
                                @if (session.Differing > 0)
                                {
                                    <span class="badge badge-warn"><span class="tabular">@session.Differing</span></span>
                                }
                                @if (session.Failed > 0)
                                {
                                    <span class="badge badge-fail"><span class="tabular">@session.Failed</span></span>
                                }
                                @if (session.AwaitingReview > 0)
                                {
                                    <span class="badge badge-running">
                                        <span class="tabular">@session.AwaitingReview</span> @T["capture.awaiting"]
                                    </span>
                                }
                            </div>
                        </td>
                        <td><partial name="Pieces/_Timestamp" model="@(new TimestampView(session.StartedAt))" /></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}

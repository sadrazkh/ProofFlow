@inject ProofFlow.Web.Infrastructure.Seeding.DemoAccount Demo

@*
    The account a development copy comes up with, printed where somebody is being asked for one.

    Only in Development, only when demo seeding is on, and only when nobody chose a password — the
    three conditions are on DemoAccount rather than here, so the page cannot print something the
    seeder did not use. Outside those conditions this renders nothing at all, not a smaller version
    of itself: a box saying «no demo account» on a production sign-in page tells an attacker what
    kind of software they are looking at and tells the reader nothing.

    It has a filled-in button rather than only text, because the point is to get past this page.
*@

@if (Demo.Show && Demo.Password is { Length: > 0 } password)
{
    <div class="demo-card">
        <p class="demo-card-title">
            <i data-lucide="flask-conical" aria-hidden="true"></i>@T["demo.title"]
        </p>

        <dl class="demo-card-rows">
            <dt>@T["auth.email"]</dt>
            <dd class="mono" dir="ltr">@ProofFlow.Web.Infrastructure.Seeding.DemoAccount.Email</dd>

            <dt>@T["auth.password"]</dt>
            <dd class="mono" dir="ltr">@password</dd>
        </dl>

        <button type="button" class="btn btn-secondary btn-sm btn-block"
                data-fill-demo="@ProofFlow.Web.Infrastructure.Seeding.DemoAccount.Email|@password">
            <i data-lucide="log-in" aria-hidden="true"></i>@T["demo.fill"]
        </button>

        <p class="demo-card-note">@T["demo.note"]</p>

        <details class="demo-card-more">
            <summary>@T["demo.colleagues"]</summary>
            <ul class="demo-card-list">
                @foreach (var colleague in ProofFlow.Web.Infrastructure.Seeding.DemoAccount.Colleagues)
                {
                    <li>
                        <span class="mono" dir="ltr">@colleague.Email</span>
                        <span class="badge badge-idle">@T[$"workspace.role_{colleague.Role}"]</span>
                    </li>
                }
            </ul>
            <p class="demo-card-note">@T["demo.colleagues.note"]</p>
        </details>
    </div>
}

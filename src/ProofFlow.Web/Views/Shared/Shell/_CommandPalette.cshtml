@{
    var projectId = Context.Items["ProjectId"] as Guid?;
    var entries = Navigation.For(Me, projectId).SelectMany(s => s.Items).ToList();
}
@if (Me.IsAuthenticated)
{
    @* The destinations are rendered server-side from the same map as the sidebar, so the palette
       can only offer routes this member is authorised to reach. Building that list in the browser
       would mean shipping the whole route table to every account.

       What somebody *made* cannot be rendered here — it is a workspace's worth of rows, and most
       of them are not wanted. Those arrive from /search as they are typed for, under the
       destinations, and are gated by the same capabilities on the way out. *@
    <div class="palette-overlay hidden" data-palette aria-hidden="true" role="dialog" aria-modal="true"
         aria-label="@T["nav.search"]" data-palette-project="@projectId">
        <div class="palette-backdrop" data-palette-backdrop
             style="position: absolute; inset: 0;"></div>
        <div class="palette" style="position: relative;">
            @*
                The combobox pattern: focus stays in the input while the highlighted row is named
                by aria-activedescendant. Moving real focus onto each row instead would take the
                caret out of the field, so typing a second character would go nowhere.
            *@
            <div class="palette-input-row">
                <i data-lucide="search" aria-hidden="true"></i>
                <input class="palette-input" data-palette-input type="text"
                       placeholder="@T["nav.searchHint"]" aria-label="@T["nav.search"]" autocomplete="off"
                       role="combobox" aria-expanded="true" aria-controls="pf-palette-list"
                       aria-autocomplete="list" />
                <span class="kbd">Esc</span>
            </div>
            <div class="palette-list" id="pf-palette-list" role="listbox" aria-label="@T["nav.search"]">
                @{ var index = 0; }
                @foreach (var entry in entries)
                {
                    <a class="menu-item" data-palette-item href="@entry.Path"
                       id="pf-palette-@index" role="option" aria-selected="false" tabindex="-1"
                       data-search="@T[entry.LabelKey] @entry.Path">
                        <i data-lucide="@entry.Icon" aria-hidden="true"></i>
                        <span class="grow">@T[entry.LabelKey]</span>
                        <span class="text-xs subtle mono">@entry.Path</span>
                    </a>
                    index++;
                }

                @* Filled in by the browser from /search. Empty in the HTML on purpose: a page that
                   pre-rendered anything here would be rendering a search nobody has asked for. *@
                <div data-palette-results></div>

                @* Its own status line rather than a spinner: «searching» and «nothing matched» are
                   different facts, and a reader who hears only the second one cannot tell a slow
                   answer from an empty one. *@
                <div class="palette-searching hidden" data-palette-loading role="status">
                    @T["search.searching"]
                </div>
                <div class="palette-empty hidden" data-palette-empty role="status">@T["nav.noResults"]</div>
            </div>
        </div>
    </div>
}

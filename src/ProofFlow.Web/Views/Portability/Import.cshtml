@model ImportStartViewModel

<div class="page page-narrow" style="padding: 0;">
    <div class="page-head">
        <div>
            <h1 class="page-title">@T["portability.import"]</h1>
            <p class="page-subtitle">@T["portability.import.subtitle"]</p>
        </div>
    </div>

    @* Three steps, and the reader can see there are three. An import is not undoable, so the shape
       of the journey matters as much as the pages in it. *@
    <partial name="Pieces/_ImportSteps" model="1" />

@*
    Two steps when script is available, one when it is not.

    A thirty-megabyte collection takes a visible amount of time to upload, and a form post shows
    nothing at all while it does — the page simply sits there. So the bytes go up on their own,
    with a real percentage, and the preview is a second request that reads them back out of memory.

    Without script the same form still posts straight to the preview, which is why the action is
    the one it always was and the upload address is an attribute rather than the target.
*@
    <form method="post" action="/projects/@Model.ProjectId/import/preview"
          enctype="multipart/form-data" class="stack-6"
          data-upload-to="/projects/@Model.ProjectId/import/upload">
        @Html.AntiForgeryToken()

        <section class="card card-pad stack">
            <h2 class="card-title">@T["portability.import.source"]</h2>

            <div class="import-sources">
                @foreach (var source in ImportStartViewModel.Sources)
                {
                    <label class="import-source">
                        <input type="radio" name="source" value="@source"
                               checked="@(source == Model.Source)" />
                        <span class="import-source-body">
                            <span class="semibold">@T[$"portability.source.{source}"]</span>
                            <span class="text-xs subtle">@T[$"portability.source.{source}.help"]</span>
                        </span>
                    </label>
                }
            </div>
        </section>

        <section class="card card-pad stack">
            <h2 class="card-title">@T["portability.import.file"]</h2>

            <div class="field">
                <label class="field-label" for="import-file">@T["portability.import.upload"]</label>
                <input class="input" id="import-file" name="file" type="file"
                       accept=".json,.yaml,.yml,.txt,application/json,text/yaml,text/plain" />
                <p class="field-hint">@T["portability.import.upload.help"]</p>
            </div>

            <div class="field">
                <label class="field-label" for="import-pasted">
                    @T["portability.import.paste"]
                    <span class="field-optional">@T["common.optional"]</span>
                </label>
                <textarea class="input input-mono" id="import-pasted" name="pasted" rows="6"
                          dir="ltr" spellcheck="false"
                          placeholder="curl https://api.example.com/products"></textarea>
                <p class="field-hint">@T["portability.import.paste.help"]</p>
            </div>
        </section>

        <section class="card card-pad stack">
            <h2 class="card-title">@T["portability.import.target"]</h2>

            <label class="check-row">
                <input class="checkbox" type="checkbox" name="asNewProject" value="true" />
                <span class="check-row-text">
                    <span class="check-row-title">@T["portability.import.asNew"]</span>
                    <span class="check-row-help">@T["portability.import.asNew.help", Model.ProjectName]</span>
                </span>
            </label>
        </section>

        <div class="row">
            <button type="submit" class="btn btn-primary">
                <i data-lucide="arrow-right" aria-hidden="true"></i>@T["portability.import.look"]
            </button>
            <a class="btn btn-ghost" href="/projects/@Model.ProjectId">@T["action.cancel"]</a>
        </div>

        @* Hidden until there is something to say, so the page does not carry an empty bar. *@
        <div class="upload-progress" hidden>
            <div class="upload-progress-track">
                <div class="upload-progress-fill"
                     role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"></div>
            </div>
            <p class="upload-progress-text" role="status" aria-live="polite"></p>
        </div>

        <input type="hidden" name="ticket" value="" />
    </form>
</div>

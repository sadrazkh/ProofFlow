@using System.Text.Json
@inject IStringLocalizer Strings
@model ApprovalViewModel

@{
    // `IStringLocalizer` beside the usual `@T`: `IViewLocalizer` substitutes its arguments when the
    // string is *written*, so reading `.Value` for an attribute hands back the template with «{0}»
    // still in it. The aria-labels below have to exist as strings before they can be attributes.
    // The same note, at more length, is in Pieces/_Sparkline.cshtml.
    var columns = Model.CanApprove ? 5 : 4;
    var islandProps = new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase };
}

<div class="page-head">
    <div>
        <h1 class="page-title">@T["approval.title"]</h1>
        <p class="page-subtitle">@T["approval.subtitle"]</p>
    </div>
</div>

@if (Model.Inbox.Total == 0)
{
    <div class="card">
        <div class="empty">
            <div class="empty-art"><i data-lucide="check-check" aria-hidden="true"></i></div>
            <h2 class="empty-title">@T["approval.empty.title"]</h2>
            <p class="empty-body">@T["approval.empty.body"]</p>
        </div>
    </div>
}
else
{
    @if (Model.Inbox.Versions.Count > 0)
    {
        <section class="card" data-bulk="versions">
            <div class="card-header">
                <div>
                    <div class="card-title">@T["approval.versions"]</div>
                    <div class="card-subtitle">@T["approval.versions.subtitle"]</div>
                </div>

                @if (Model.CanApprove)
                {
                    @*
                        The bulk form sits outside the table on purpose: each row already carries an
                        Approve form of its own, and forms do not nest. The boxes in the rows point
                        back here with their `form` attribute, which is what lets one press act on
                        several rows without taking the single press away from any of them.

                        The button starts disabled because at first paint nothing is ticked. Script
                        enables it; see mountBulkSelect.
                    *@
                    <form id="approve-selected" method="post" class="approval-bulk" data-bulk-bar
                          action="/projects/@Model.ProjectId/approvals/approve">
                        @Html.AntiForgeryToken()

                        <span class="text-xs subtle tabular"
                              data-bulk-count="versions"
                              data-bulk-count-text="approval.selectedCount"
                              aria-live="polite"></span>

                        <button type="submit" class="btn btn-primary btn-sm"
                                data-bulk-action="versions" disabled>
                            <i data-lucide="check-check" aria-hidden="true"></i>@T["approval.approveSelected"]
                        </button>
                    </form>
                }
            </div>

            <div class="table-wrap">
                <table class="table table-hover approval-table">
                    <caption class="sr-only">@T["approval.versions"]</caption>
                    <thead>
                    <tr>
                        @if (Model.CanApprove)
                        {
                            <th class="cell-tick">
                                <input type="checkbox" class="checkbox"
                                       data-bulk-all="versions"
                                       form="approve-selected"
                                       aria-label="@Strings["approval.selectAll"].Value" />
                            </th>
                        }
                        <th>@T["common.name"]</th>
                        <th>@T["approval.recordedBy"]</th>
                        <th>@T["common.created"]</th>
                        <th><span class="sr-only">@T["common.actions"]</span></th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var version in Model.Inbox.Versions)
                    {
                        var yours = version.ByYou && Model.Inbox.SomebodyElseCanApprove;
                        var mine = Model.CanApprove && !yours;
                        var panelId = $"version-diff-{version.VersionId}";

                        var props = JsonSerializer.Serialize(new
                        {
                            path = $"/projects/{Model.ProjectId}/endpoints/{version.BaselineId}"
                                   + $"/versions/{version.VersionId}/diff",
                            endpointName = version.BaselineName,
                            number = version.Number,
                            panelId,
                        }, islandProps);

                        <tr>
                            @if (Model.CanApprove)
                            {
                                <td class="cell-tick">
                                    @if (mine)
                                    {
                                        @* Named after the row it ticks: "select" on its own is four
                                           identical controls to anybody reading by label. *@
                                        <input type="checkbox" class="checkbox"
                                               name="versionIds" value="@version.VersionId"
                                               data-bulk-item="versions"
                                               form="approve-selected"
                                               aria-label="@Strings["approval.select", version.BaselineName, version.Number].Value" />
                                    }
                                </td>
                            }
                            <td>
                                <a href="/projects/@Model.ProjectId/endpoints/@version.BaselineId" dir="auto">
                                    @version.BaselineName
                                </a>
                                <span class="badge badge-idle tabular" dir="ltr">v@(version.Number)</span>
                            </td>
                            <td>
                                <span dir="auto">@version.RecordedBy</span>
                                @if (version.ByYou)
                                {
                                    <span class="badge badge-accent">@T["team.you"]</span>
                                }
                            </td>
                            <td><partial name="Pieces/_Timestamp" model="@(new TimestampView(version.RecordedAt))" /></td>
                            <td>
                                @*
                                    Somebody who recorded it cannot approve it — while there is
                                    somebody else who could. Said here rather than after the press,
                                    because finding out a rule by being refused is a bad way to
                                    learn one.
                                *@
                                @if (Model.CanApprove && yours)
                                {
                                    <span class="approval-yours">
                                        <i data-lucide="user-check" aria-hidden="true"></i>
                                        @T["approval.waitingOnSomebodyElse"]
                                    </span>
                                }
                                else if (Model.CanApprove)
                                {
                                    <div class="row">
                                        <form method="post"
                                              action="/projects/@Model.ProjectId/endpoints/@version.BaselineId/versions/@version.VersionId/approve">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-secondary btn-sm">
                                                <i data-lucide="check" aria-hidden="true"></i>@T["approval.approve"]
                                            </button>
                                        </form>

                                        <a class="btn btn-ghost btn-sm"
                                           href="/projects/@Model.ProjectId/endpoints/@version.BaselineId">
                                            @T["approval.look"]
                                        </a>
                                    </div>
                                }
                                else
                                {
                                    <a class="btn btn-ghost btn-sm"
                                       href="/projects/@Model.ProjectId/endpoints/@version.BaselineId">
                                        @T["approval.look"]
                                    </a>
                                }
                            </td>
                        </tr>

                        @*
                            The evidence, under the row it belongs to. A second row rather than a
                            panel inside a cell, because a diff is the width of the table and a
                            table cell is not.

                            Empty until the island mounts, and that is deliberate: the disclosure
                            fetches a comparison that does not exist on the server-rendered page, so
                            offering the control where it could not work would be offering a dead
                            button. Without script the row is invisible and «Look at it» is still
                            the way through.
                        *@
                        <tr class="approval-detail-row">
                            <td colspan="@columns" class="approval-detail-cell"
                                data-island="version-diff" data-props="@props"></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>

            @if (Model.Inbox.MoreVersions > 0)
            {
                <div class="card-body">
                    @* Counted rather than silently cut. *@
                    <p class="text-xs subtle">@T["approval.more", Model.Inbox.MoreVersions]</p>
                </div>
            }
        </section>
    }

    @if (Model.Inbox.Sessions.Count > 0)
    {
        <section class="card">
            <div class="card-header">
                <div>
                    <div class="card-title">@T["approval.sessions"]</div>
                    <div class="card-subtitle">@T["approval.sessions.subtitle"]</div>
                </div>
            </div>

            @*
                No ticking here, and that is a decision rather than an omission. A proposed version
                is one answer and one decision; a sweep is two thousand answers, each of which is
                its own. «Approve these three sweeps» could only mean «bless every waiting sample in
                them, including the ones that differ» — which is the blind approval the rows above
                were changed to stop. The review queue inside the endpoint already selects samples
                in bulk, with the diff for each one on screen, which is where that belongs.
            *@
            <div class="table-wrap">
                <table class="table table-hover">
                    <caption class="sr-only">@T["approval.sessions"]</caption>
                    <thead>
                    <tr>
                        <th>@T["common.name"]</th>
                        <th>@T["approval.waiting"]</th>
                        <th>@T["approval.recordedBy"]</th>
                        <th>@T["run.column.started"]</th>
                        <th><span class="sr-only">@T["common.actions"]</span></th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var session in Model.Inbox.Sessions)
                    {
                        <tr>
                            <td dir="auto">@session.BaselineName</td>
                            <td>
                                <span class="tabular" dir="ltr">@session.Waiting</span>
                                @if (session.Differing > 0)
                                {
                                    @* The ones worth opening first: something moved. *@
                                    <span class="badge badge-warn tabular" dir="ltr"
                                          title="@T["approval.differing", session.Differing]">
                                        @session.Differing
                                    </span>
                                }
                            </td>
                            <td>
                                <span dir="auto">@session.StartedBy</span>
                                @if (session.ByYou)
                                {
                                    <span class="badge badge-accent">@T["team.you"]</span>
                                }
                            </td>
                            <td><partial name="Pieces/_Timestamp" model="@(new TimestampView(session.StartedAt))" /></td>
                            <td>
                                @* To the endpoint the sweep belongs to, at the section that shows
                                   what it found. There is no page for a capture session any more,
                                   and there should not be: a sweep is something an endpoint did. *@
                                <a class="btn btn-secondary btn-sm"
                                   href="/projects/@Model.ProjectId/endpoints/@session.BaselineId#test">
                                    @T["approval.review"]
                                </a>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>

            @if (Model.Inbox.MoreSessions > 0)
            {
                <div class="card-body">
                    <p class="text-xs subtle">@T["approval.more", Model.Inbox.MoreSessions]</p>
                </div>
            }
        </section>
    }
}

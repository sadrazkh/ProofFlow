@model EnvironmentsPageViewModel
@{
    var selectedId = Model.Selected!.Id;
}
<section class="card">
    <div class="card-header">
        <div>
            <h2 class="card-title">@T["environment.secrets"]</h2>
            <p class="card-subtitle">@T["secret.subtitle"]</p>
        </div>
    </div>

    @if (Model.Secrets.Count == 0)
    {
        <div class="empty empty-inline">
            <div class="empty-art"><i data-lucide="key-round" aria-hidden="true"></i></div>
            <p class="empty-body">@T["secret.empty.body"]</p>
        </div>
    }
    else
    {
        <div class="table-wrap">
            <table class="table">
                <thead>
                <tr>
                    <th>@T["common.name"]</th>
                    <th>@T["secret.value"]</th>
                    <th>@T["variable.scope"]</th>
                    <th>@T["secret.lastUsed"]</th>
                    <th class="numeric"><span class="sr-only">@T["action.more"]</span></th>
                </tr>
                </thead>
                <tbody>
                @foreach (var secret in Model.Secrets)
                {
                    <tr>
                        <td class="mono">{{secrets.@secret.Name}}</td>
                        <td>
                            @*
                                The value is never rendered here. The dots are a placeholder and the
                                last four characters are enough to tell the staging key from the
                                production one — the whole reason anyone looks at this column.
                            *@
                            <span class="secret-value mono" data-secret-id="@secret.Id">
                                <span data-secret-mask>••••••••@secret.Preview</span>
                            </span>
                        </td>
                        <td>
                            @if (secret.IsInherited)
                            {
                                <span class="badge badge-idle has-tip" data-tip="@T["variable.inherited.hint"]">
                                    @T["variable.inherited"]
                                </span>
                            }
                            else
                            {
                                <span class="badge badge-accent">@Model.Selected!.Name</span>
                            }
                        </td>
                        <td class="subtle">
                            @if (secret.LastUsedAt is { } used)
                            {
                                <partial name="Pieces/_Timestamp" model="@(new TimestampView(used))" />
                            }
                            else
                            {
                                @* .subtle, not .faint: «never» is the answer to the column, not a
                                   decorative mark, and .faint sits below the reading threshold. *@
                                <span class="subtle">@T["common.never"]</span>
                            }
                        </td>
                        <td class="numeric">
                            <span class="row" style="gap: var(--space-1); justify-content: flex-end;">
                                @if (Model.CanRevealSecrets)
                                {
                                    @* Every press writes an audit entry server-side. The button is
                                       absent — not disabled — for anyone without the capability. *@
                                    <button type="button" class="btn btn-ghost btn-icon btn-sm has-tip"
                                            data-secret-reveal="@secret.Id"
                                            data-secret-url="/projects/@Model.ProjectId/environments/secrets/@secret.Id/reveal"
                                            data-tip="@T["secret.reveal"]" aria-label="@T["secret.reveal"]">
                                        <i data-lucide="eye" aria-hidden="true"></i>
                                    </button>
                                }
                                @if (Model.CanManageSecrets)
                                {
                                    <form method="post"
                                          action="/projects/@Model.ProjectId/environments/secrets/@secret.Id/delete?selected=@selectedId"
                                          data-confirm="@T["secret.deleteBody", secret.Name]"
                                          data-confirm-title="@T["secret.deleteTitle"]"
                                          data-confirm-action="@T["action.delete"]">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-ghost btn-icon btn-sm has-tip"
                                                data-tip="@T["action.delete"]" aria-label="@T["action.delete"]">
                                            <i data-lucide="trash-2" aria-hidden="true"></i>
                                        </button>
                                    </form>
                                }
                            </span>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }

    @if (Model.CanManageSecrets)
    {
        <form method="post" action="/projects/@Model.ProjectId/environments/secrets" class="card-footer"
              style="justify-content: flex-start; flex-wrap: wrap; align-items: flex-end;"
              autocomplete="off">
            @Html.AntiForgeryToken()
            <div class="field" style="min-inline-size: 160px;">
                <label class="field-label" for="secret-name">@T["common.name"]</label>
                <input class="input input-mono" id="secret-name" name="Name" required placeholder="apiToken" />
            </div>
            <div class="field grow" style="min-inline-size: 200px;">
                <label class="field-label" for="secret-value">@T["secret.value"]</label>
                @* type=password so it is not shoulder-read while being pasted, and
                   autocomplete=new-password so no browser offers to remember it. *@
                <input class="input input-mono" id="secret-value" name="Value" type="password"
                       autocomplete="new-password" required />
            </div>
            <div class="field" style="min-inline-size: 180px;">
                <label class="field-label" for="secret-scope">@T["variable.scope"]</label>
                <select class="select" id="secret-scope" name="EnvironmentId">
                    <option value="@selectedId">@Model.Selected!.Name</option>
                    <option value="">@T["variable.allEnvironments"]</option>
                </select>
            </div>
            <button type="submit" class="btn btn-secondary">@T["secret.add"]</button>
        </form>
    }
</section>

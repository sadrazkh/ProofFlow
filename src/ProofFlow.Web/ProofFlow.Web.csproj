<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\ProofFlow.Domain\ProofFlow.Domain.csproj" />
    <ProjectReference Include="..\ProofFlow.Contracts\ProofFlow.Contracts.csproj" />
    <ProjectReference Include="..\ProofFlow.Application\ProofFlow.Application.csproj" />
    <ProjectReference Include="..\ProofFlow.TestEngine\ProofFlow.TestEngine.csproj" />
    <ProjectReference Include="..\ProofFlow.Infrastructure\ProofFlow.Infrastructure.csproj" />
    <!-- Hosted only in development, so the demo has something to point at without a
         second terminal or an internet connection. Never mapped in production. -->
    <ProjectReference Include="..\ProofFlow.FakeApi\ProofFlow.FakeApi.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Vite's output. Excluded from compilation so a stale build directory can never break the
         .NET build, and never watched, because the watcher would restart the host on every asset
         Vite writes during `npm run watch`. -->
    <Content Remove="wwwroot\build\**" />
    <None Include="wwwroot\build\**" CopyToOutputDirectory="PreserveNewest" Watch="false" />
    <Content Remove="node_modules\**" />
    <None Remove="node_modules\**" />
    <Compile Remove="node_modules\**" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ProofFlow.Tests" />
    <InternalsVisibleTo Include="ProofFlow.IntegrationTests" />
  </ItemGroup>

</Project>

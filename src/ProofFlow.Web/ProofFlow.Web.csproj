<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\ProofFlow.Domain\ProofFlow.Domain.csproj" />
    <ProjectReference Include="..\ProofFlow.Contracts\ProofFlow.Contracts.csproj" />
    <ProjectReference Include="..\ProofFlow.Application\ProofFlow.Application.csproj" />
    <ProjectReference Include="..\ProofFlow.TestEngine\ProofFlow.TestEngine.csproj" />
    <ProjectReference Include="..\ProofFlow.Infrastructure\ProofFlow.Infrastructure.csproj" />
    <!-- Hosted only in development, so the demo has something to point at without a
         second terminal or an internet connection. Never mapped in production. -->
    <ProjectReference Include="..\ProofFlow.FakeApi\ProofFlow.FakeApi.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Vite's output, kept out of every item list this project is evaluated with.

         Not listed at all, rather than listed and excluded from compilation. Item globs are
         expanded when the project file is read, and these filenames are content hashes that this
         build is about to change — so a listed glob holds the *previous* build's names, and the
         copy step fails with «could not copy, it was not found» on exactly the builds where
         something changed. The copy is done by hand below, after Vite has run. -->
    <Content Remove="wwwroot\build\**" />
    <None Remove="wwwroot\build\**" />
    <Content Remove="node_modules\**" />
    <None Remove="node_modules\**" />
    <Compile Remove="node_modules\**" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ProofFlow.Tests" />
    <InternalsVisibleTo Include="ProofFlow.IntegrationTests" />
  </ItemGroup>

  <!--
    The front end, built by the .NET build.

    It used to be a separate command somebody had to remember, and the failure it produced is the
    worst kind: pressing F5 in Visual Studio served whatever JavaScript happened to be in
    wwwroot/build from the last time anybody ran Vite. Everything looked right, the page worked, and
    a feature added that morning simply was not there — with no error anywhere to explain it.

    Incremental, so it costs nothing when nothing changed: MSBuild compares the sources against a
    stamp file and skips the target entirely. `npm install` runs only when node_modules is missing.
    Set SkipFrontendBuild=true for a build that must not shell out — CI builds the assets itself
    before it builds the solution.
  -->
  <PropertyGroup>
    <FrontendStamp>$(BaseIntermediateOutputPath)frontend.stamp</FrontendStamp>
    <NpmCommand Condition="'$(OS)' == 'Windows_NT'">npm.cmd</NpmCommand>
    <NpmCommand Condition="'$(OS)' != 'Windows_NT'">npm</NpmCommand>
  </PropertyGroup>

  <ItemGroup>
    <FrontendSource Include="Scripts\**\*" Exclude="Scripts\**\*.spec.ts" />
    <FrontendSource Include="package.json;package-lock.json;vite.config.ts;tsconfig.json" />
  </ItemGroup>

  <Target Name="BuildFrontend"
          BeforeTargets="AssignTargetPaths"
          Condition="'$(SkipFrontendBuild)' != 'true'"
          Inputs="@(FrontendSource)"
          Outputs="$(FrontendStamp)">

    <Message Importance="high" Text="ProofFlow: building the front end (Vite)…" />

    <Exec Command="$(NpmCommand) install --no-audit --no-fund"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          Condition="!Exists('$(MSBuildProjectDirectory)/node_modules')" />

    <!-- build:fast, because vue-tsc is a separate gate the test run already enforces. -->
    <Exec Command="$(NpmCommand) run build:fast" WorkingDirectory="$(MSBuildProjectDirectory)" />

    <Touch Files="$(FrontendStamp)" AlwaysCreate="true" />
  </Target>

  <!--
    Copied by hand, after Vite has run.

    Two attempts at doing this with item metadata failed the same way, and it is worth writing down
    why. A glob in an outer ItemGroup expands at evaluation time — before this build has run — so it
    holds the previous build's hashed filenames. Re-globbing inside a target hooked to
    BeforeTargets="AssignTargetPaths" looked like the fix and was not: the copy list is captured
    from several places in the SDK, and «before this one particular target» turned out not to be
    before all of them. The failure was intermittent in the worst way — every build that changed a
    bundle failed, and the retry immediately afterwards succeeded, which reads as flakiness rather
    than as an ordering bug.

    A Copy task after Build has no ordering question in it at all. The item is collected inside the
    target, so it is expanded when the files exist, and it runs once the rest of the build has
    finished writing.
  -->
  <Target Name="CopyFrontendOutput" AfterTargets="Build">
    <ItemGroup>
      <FrontendOutput Include="wwwroot\build\**" />
    </ItemGroup>

    <Copy SourceFiles="@(FrontendOutput)"
          DestinationFolder="$(OutDir)wwwroot\build\%(RecursiveDir)"
          SkipUnchangedFiles="true" />
  </Target>

  <!--
    And into the published output, which does not go through OutDir.

    ResolvedFileToPublish rather than a second Copy: the publish pipeline builds its own list and a
    file copied outside it is a file `dotnet publish` will happily delete again.
  -->
  <Target Name="PublishFrontendOutput"
          BeforeTargets="ComputeResolvedFilesToPublishList"
          DependsOnTargets="BuildFrontend">
    <ItemGroup>
      <FrontendOutput Include="wwwroot\build\**" />

      <ResolvedFileToPublish Include="@(FrontendOutput)">
        <RelativePath>wwwroot\build\%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>

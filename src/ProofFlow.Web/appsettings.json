{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Database": {
    // "sqlite" or "postgres". Left empty, a connection string that names a host selects
    // PostgreSQL and anything else selects the SQLite file.
    "Provider": "sqlite",
    // On for SQLite (one process, one file) and off for PostgreSQL, where two instances behind a
    // load balancer applying DDL at once is worse than a refusal to start.
    "AutoMigrate": true
  },

  "ConnectionStrings": {
    // Empty on purpose. SQLite falls back to App_Data/proofflow.db; PostgreSQL requires this to be
    // supplied through user-secrets or the environment so a password never lands in a commit.
    "Default": ""
  },

  "Demo": {
    // Creates the demo workspace and a signed-in account on first boot. Off unless switched on:
    // a seeded account with a known password is a back door, and one that appears by default is a
    // back door nobody decided to open.
    "Seed": false,
    "Password": ""
  },

  "App": {
    // The address people type to reach this installation, for example
    // "https://proofflow.example.com". Empty means links in email are built from the request's Host
    // header, which is fine on a laptop and is a password-reset poisoning hole behind a proxy — so
    // set it, or keep AllowedHosts narrow, before configuring Smtp below.
    "PublicUrl": ""
  },

  "Smtp": {
    // Empty on purpose. With no Host there is no mail server, and the product says so instead of
    // claiming to have sent an invitation or a reset link that will never arrive.
    "Host": "",
    // 587 and STARTTLS. Implicit TLS on 465 is not supported by the framework's client.
    "Port": 587,
    "UseTls": true,
    "UserName": "",
    // Supplied through user-secrets or the environment. Never committed, never logged, never shown.
    "Password": "",
    "From": "",
    "FromName": "ProofFlow"
  },

  "Vite": {
    "UseDevServer": false,
    "DevServerUrl": "http://localhost:5173"
  }
}
